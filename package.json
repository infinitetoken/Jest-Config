{
  "name": "@infinitetoken/jest-config",
  "version": "0.2.3",
  "description": "Shared Jest configuration for InfiniteToken TypeScript packages",
  "keywords": [
    "config",
    "jest",
    "jestconfig",
    "testing",
    "ts-jest"
  ],
  "homepage": "https://github.com/infinitetoken/jest-config#readme",
  "bugs": {
    "url": "https://github.com/infinitetoken/jest-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinitetoken/jest-config.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    "./expo": {
      "types": "./src/configs/expo.d.ts",
      "default": "./src/configs/expo.cjs"
    },
    "./node": {
      "types": "./src/configs/node.d.ts",
      "default": "./src/configs/node.cjs"
    },
    "./react-native": {
      "types": "./src/configs/react-native.d.ts",
      "default": "./src/configs/react-native.cjs"
    },
    "./setup": "./src/configs/setup.cjs"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "fix": "eslint . --fix",
    "lint": "eslint .",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "node scripts/verify-exports.cjs",
    "verify": "npm run lint && npm test",
    "preversion": "npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "dependencies": {
    "ts-jest": "^29.4.11"
  },
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.1.4",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^13.2.5",
    "eslint": "^10.2.1",
    "expo": "^57.0.17",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-expo": "^57.0.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "jest": "^29.7.0 || ^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-expo": ">=57.0.0",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "jest-environment-jsdom": {
      "optional": true
    },
    "jest-expo": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
